<Window x:Class="CollegeScheduleGadget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Width="760" Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        MinWidth="650" MinHeight="420" Background="#1C2430"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#18202B" Padding="12">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Налаштування" Foreground="White" FontSize="20"
                       FontWeight="SemiBold" Margin="8,8,8,24"/>
                <Button x:Name="GeneralTabButton" Content="⚙  Загальні" Click="GeneralTab_Click"
                    Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="ScheduleTabButton" Content="▣  Розклад" Click="ScheduleTab_Click"
                    Style="{StaticResource NavigationButtonStyle}"/>
            </StackPanel>
            <Button x:Name="AboutTabButton" Grid.Row="1" Content="ⓘ  Про програму" Click="AboutTab_Click"
                Style="{StaticResource NavigationButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#F01C2430" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="Загальні" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <TextBlock Text="Група за замовчуванням" Foreground="#D8FFFFFF"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <TextBox x:Name="GroupInput" Height="34" Padding="8,5" FontSize="14"
                                     TextChanged="GroupInput_TextChanged"/>
                            <ListBox x:Name="GroupSuggestions" MaxHeight="110" Visibility="Collapsed"
                                     SelectionChanged="GroupSuggestions_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Ця група завантажуватиметься після запуску програми."
                                       Foreground="#99FFFFFF" FontSize="12" Margin="0,10,0,0"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Запускати разом із Windows"
                                      Foreground="#D8FFFFFF" Margin="0,24,0,0"/>
                            <CheckBox x:Name="DisableNotificationsCheckBox"
                                      Content="Вимкнути сповіщення про наближення пари"
                                      Foreground="#D8FFFFFF" Margin="0,10,0,0"/>
                            <Button Content="Перевірити оновлення" Click="CheckUpdatesButton_Click"
                                    HorizontalAlignment="Left" Padding="14,8" Margin="0,18,0,0"/>
                            <TextBlock x:Name="UpdateStatusText" Foreground="#99FFFFFF"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button Content="Оновлення розкладу" Click="TestRefreshButton_Click"
                                    HorizontalAlignment="Left" Padding="12,7" Margin="0,22,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SchedulePanel" Visibility="Collapsed">
                            <TextBlock Text="Розклад" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Прозорість віджета" Foreground="#D8FFFFFF"
                                           FontSize="14"/>
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                                           Foreground="#D8FFFFFF" FontSize="14"/>
                            </DockPanel>
                                <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="1" Height="28"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    PreviewMouseLeftButtonDown="OpacitySlider_PreviewMouseLeftButtonDown"/>
                                <TextBlock Text="Розмір тексту" Foreground="#D8FFFFFF" FontSize="14"
                                       Margin="0,22,0,8"/>
                                <ComboBox x:Name="TextSizeComboBox" SelectedValuePath="Tag" Height="34">
                                <ComboBoxItem Content="Маленький" Tag="Small"/>
                                <ComboBoxItem Content="Середній" Tag="Medium"/>
                                <ComboBoxItem Content="Великий" Tag="Large"/>
                                </ComboBox>
                            <TextBlock Text="Тема" Foreground="#D8FFFFFF" FontSize="14" Margin="0,0,0,8"/>
                            <ComboBox x:Name="ThemeComboBox" SelectedValuePath="Tag" Height="34">
                                <ComboBoxItem Content="Midnight · синій чорний" Tag="Midnight"/>
                                <ComboBoxItem Content="Violet · фіолетовий" Tag="Violet"/>
                                <ComboBoxItem Content="Ember · помаранчевий" Tag="Ember"/>
                                <ComboBoxItem Content="Graphite · сірий чорний" Tag="Graphite"/>
                                <ComboBoxItem Content="Cyberpunk · неоновий" Tag="Cyberpunk"/>
                                <ComboBoxItem Content="Matcha · зелений чай" Tag="Matcha"/>
                                <ComboBoxItem Content="Ocean · глибокий синій" Tag="Ocean"/>
                            </ComboBox>
                            <TextBlock Text="Стиль картки" Foreground="#D8FFFFFF" FontSize="14"
                                       Margin="0,22,0,8"/>
                            <ComboBox x:Name="StyleComboBox" SelectedValuePath="Tag" Height="34">
                                <ComboBoxItem Content="Стандартний" Tag="Minimalism"/>
                                <ComboBoxItem Content="Хмаринка" Tag="Cloud"/>
                            </ComboBox>
                                <TextBlock Text="Власний колір" Foreground="#D8FFFFFF" FontSize="14"
                                       Margin="0,22,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CustomColorPreview" Width="42" Height="34"
                                        Background="Transparent" CornerRadius="8"
                                        BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                    <Button Content="Обрати колір" Click="CustomColorButton_Click"
                                        Padding="12,7" Margin="10,0,0,0"/>
                                    <Button Content="Скинути" Click="ResetColorButton_Click"
                                        Padding="12,7" Margin="8,0,0,0"/>
                                </StackPanel>
                            <TextBlock Text="Тема та стиль збережуться після перезапуску."
                                       Foreground="#99FFFFFF" FontSize="12" Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <TextBlock Text="Про програму" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <TextBlock Text="College Schedule Gadget" Foreground="#D8FFFFFF"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Версія 1.1"
                                       Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0"/>
                            <TextBlock Text="Створено студентом групи АК-25-02 Настишиним Д. І. для ВСП «ФКЕП ІФНТУНГ»."
                                       Foreground="#99FFFFFF" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Розклад, відлік пар і швидкі налаштування."
                                       Foreground="#99FFFFFF" FontSize="13" Margin="0,4,0,24" TextWrapping="Wrap"/>
                            
                            <Button Content="Повідомити про баг (Telegram)" Click="TgSupportButton_Click"
                                    HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,10"/>
                            <Button Content="Підтримати фінансово (Банка)" Click="DonateButton_Click"
                                    HorizontalAlignment="Left" Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button Content="Скасувати" Click="CancelButton_Click" Padding="14,7"
                            Margin="0,0,8,0"/>
                    <Button Content="Зберегти" Click="SaveButton_Click" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>