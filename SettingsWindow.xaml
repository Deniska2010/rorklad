<Window x:Class="CollegeScheduleGadget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Width="760" Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        MinWidth="650" MinHeight="420" Background="#1C2430"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#18202B" Padding="12">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Налаштування" Foreground="White" FontSize="20"
                       FontWeight="SemiBold" Margin="8,8,8,24"/>
                <Button Content="Загальні" Click="GeneralTab_Click"
                    Style="{StaticResource NavigationButtonStyle}"/>
                <Button Content="Розклад" Click="ScheduleTab_Click"
                    Style="{StaticResource NavigationButtonStyle}"/>
                <Button Content="Зовнішній вигляд" Click="AppearanceTab_Click"
                    Style="{StaticResource NavigationButtonStyle}"/>
            </StackPanel>
            <Button Grid.Row="1" Content="Про програму" Click="AboutTab_Click"
                Style="{StaticResource NavigationButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#F01C2430" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="Загальні" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <TextBlock Text="Група за замовчуванням" Foreground="#D8FFFFFF"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <TextBox x:Name="GroupInput" Height="34" Padding="8,5" FontSize="14"
                                     TextChanged="GroupInput_TextChanged"/>
                            <ListBox x:Name="GroupSuggestions" MaxHeight="110" Visibility="Collapsed"
                                     SelectionChanged="GroupSuggestions_SelectionChanged"/>
                            <TextBlock Text="Ця група завантажуватиметься після запуску програми."
                                       Foreground="#99FFFFFF" FontSize="12" Margin="0,10,0,0"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Запускати разом із Windows"
                                      Foreground="#D8FFFFFF" Margin="0,24,0,0"/>
                                <Button Content="Перевірити оновлення" Click="CheckUpdatesButton_Click"
                                    HorizontalAlignment="Left" Padding="14,8" Margin="0,18,0,0"/>
                                <TextBlock x:Name="UpdateStatusText" Foreground="#99FFFFFF"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SchedulePanel" Visibility="Collapsed">
                            <TextBlock Text="Розклад" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Прозорість віджета" Foreground="#D8FFFFFF"
                                           FontSize="14"/>
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"
                                           Foreground="#D8FFFFFF" FontSize="14"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" Height="28"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="Зовнішній вигляд" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <TextBlock Text="Тема" Foreground="#D8FFFFFF" FontSize="14" Margin="0,0,0,8"/>
                            <ComboBox x:Name="ThemeComboBox" SelectedValuePath="Tag" Height="34">
                                <ComboBoxItem Content="Midnight · синій чорний" Tag="Midnight"/>
                                <ComboBoxItem Content="Violet · фіолетовий" Tag="Violet"/>
                                <ComboBoxItem Content="Ember · помаранчевий" Tag="Ember"/>
                                <ComboBoxItem Content="Graphite · сірий чорний" Tag="Graphite"/>
                            </ComboBox>
                            <TextBlock Text="Стиль картки" Foreground="#D8FFFFFF" FontSize="14"
                                       Margin="0,22,0,8"/>
                            <ComboBox x:Name="StyleComboBox" SelectedValuePath="Tag" Height="34">
                                <ComboBoxItem Content="Мінімалізм · поточний" Tag="Minimalism"/>
                                <ComboBoxItem Content="Повітряний · більше простору" Tag="Airy"/>
                                <ComboBoxItem Content="Компактний · більше інформації" Tag="Compact"/>
                            </ComboBox>
                            <TextBlock Text="Тема та стиль збережуться після перезапуску."
                                       Foreground="#99FFFFFF" FontSize="12" Margin="0,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <TextBlock Text="Про програму" Foreground="White" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,0,0,24"/>
                            <TextBlock Text="College Schedule Gadget" Foreground="#D8FFFFFF"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Версія 1.0\nРозклад, відлік пар і швидкі налаштування."
                                       Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button Content="Скасувати" Click="CancelButton_Click" Padding="14,7"
                            Margin="0,0,8,0"/>
                    <Button Content="Зберегти" Click="SaveButton_Click" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
