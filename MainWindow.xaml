<Window x:Class="CollegeScheduleGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="College Schedule Gadget" Height="430" Width="340" MinWidth="260" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged" Loaded="Window_Loaded" StateChanged="MainWindow_StateChanged">
    
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#33FFFFFF"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#40FFFFFF" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin="8" дозволяє мишці схопити край вікна -->
    <Border x:Name="ScheduleCard" Background="#C0141414" CornerRadius="12" Padding="10" Margin="8">
        <Grid>
            <Grid x:Name="SetupView" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Налаштування" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBox x:Name="GroupInput" Background="#1AFFFFFF" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,2" TextAlignment="Center" TextChanged="GroupInput_TextChanged"/>
                    <ListBox x:Name="GroupSuggestions" MaxHeight="100" Margin="0,0,0,10" Visibility="Collapsed" SelectionChanged="GroupSuggestions_SelectionChanged" Background="#2B2B2C" BorderThickness="1" BorderBrush="#33FFFFFF" Foreground="White" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Зберегти" Click="StartButton_Click" Background="#4CC2FF" Foreground="Black" FontWeight="Bold" BorderThickness="0" Padding="10" Cursor="Hand">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <TextBlock x:Name="SetupStatusText" Foreground="#99FFFFFF" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ScheduleView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock x:Name="GroupTitle" Text="Група" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="1 тиж." Foreground="#99FFFFFF" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="UpdateButton" Content="🎁" Click="UpdateButton_Click" Visibility="Collapsed" Style="{StaticResource IconButtonStyle}" Foreground="#4CC2FF" FontSize="14"/>
                        <Button x:Name="SettingsButton" Content="⚙" Click="SettingsButton_Click" Style="{StaticResource IconButtonStyle}" FontSize="14"/>
                        <Button x:Name="PinButton" Content="📌" Click="PinButton_Click" Style="{StaticResource IconButtonStyle}" FontSize="14"/>
                        <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" Style="{StaticResource IconButtonStyle}" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock x:Name="CountdownText" Text="Завантаження..." Foreground="#4CC2FF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>

                <ScrollViewer x:Name="LessonsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LessonsPanel" Orientation="Vertical" Margin="0,0,0,10"/>
                </ScrollViewer>
                
                <StackPanel x:Name="EmptyDayPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyDayFace" Text=":)" Foreground="#4CC2FF" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="EmptyDayMessage" Text="Пар немає" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="❮" Click="PreviousDayButton_Click" Style="{StaticResource IconButtonStyle}" FontSize="14"/>
                        <TextBlock x:Name="SelectedDayText" Text="Вівторок" Foreground="#99FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="❯" Click="NextDayButton_Click" Style="{StaticResource IconButtonStyle}" FontSize="14"/>
                        <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>