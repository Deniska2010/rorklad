<Window x:Class="CollegeScheduleGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Розклад" Height="320" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#C0141414" CornerRadius="12" Padding="15">
        <StackPanel>
            <TextBlock Text="АК-25-02 | П'ятниця (1 тиж.)" 
                       Foreground="White" FontSize="15" FontWeight="Bold" 
                       Margin="0,0,0,10" Padding="0,0,0,5"/>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="1 пара (08:00 - 09:20)" Foreground="#99FFFFFF" FontSize="12"/>
                <TextBlock Text="Українська література" Foreground="White" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="👨‍🏫 Черковський Р.В.    🚪 ауд. 301" Foreground="White" FontSize="13"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="2 пара (09:30 - 10:50)" Foreground="#99FFFFFF" FontSize="12"/>
                <TextBlock Text="Історія України" Foreground="#00D2FF" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="👨‍🏫 Боднарчук О.В.      🚪 ауд. 215" Foreground="#00D2FF" FontSize="13"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="3 пара (11:10 - 12:30)" Foreground="#99FFFFFF" FontSize="12"/>
                <TextBlock Text="Основи економічної теорії" Foreground="White" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="👩‍🏫 Силкіна Г.А.        🚪 ауд. 410" Foreground="White" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>