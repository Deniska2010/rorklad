<Window x:Class="CollegeScheduleGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Розклад" Height="430" Width="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" MinWidth="280" MinHeight="260"
        Topmost="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ScheduleCard" Background="#C0141414" CornerRadius="12" Padding="15">
        <Border.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="Foreground" Value="#D8FFFFFF"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#F02B3038"/>
                <Setter Property="Foreground" Value="#F5F7FA"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="#334B5563" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ArrowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#D8FFFFFF"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#263A4350"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
            <StackPanel x:Name="SetupView">
                <TextBlock Text="Оберіть групу" Foreground="White" FontSize="22"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Введіть назву групи, щоб завантажити ваш розклад."
                           Foreground="#B8FFFFFF" FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,20"/>
                <TextBox x:Name="GroupInput" Height="34" Padding="8,5" FontSize="14"
                         ToolTip="Почніть вводити назву групи"
                         TextChanged="GroupInput_TextChanged"/>
                <ListBox x:Name="GroupSuggestions" MaxHeight="130" Visibility="Collapsed"
                         SelectionChanged="GroupSuggestions_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Показати розклад" Click="StartButton_Click"
                        HorizontalAlignment="Left" Padding="14,8" Margin="0,16,0,0"/>
                <TextBlock x:Name="SetupStatusText" Foreground="#99FFFFFF" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>

            <Grid x:Name="ScheduleView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GroupTitle" Text="Розклад" Foreground="White"
                               FontSize="17" FontWeight="Bold" Margin="0,0,12,10"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               MinWidth="0" ToolTip="Розклад"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="×" Click="CloseButton_Click"
                                    Style="{StaticResource IconButtonStyle}" ToolTip="Закрити"/>
                            <Button x:Name="UpdateButton" Content="↻" Click="UpdateButton_Click"
                                Visibility="Collapsed" Style="{StaticResource IconButtonStyle}"
                                ToolTip="Доступне оновлення"/>
                        <Button x:Name="PinButton" Content="📌" Click="PinButton_Click"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Закріпити"/>
                        <Button Content="⚙" Click="SettingsButton_Click" Width="30" Height="30"
                            Style="{StaticResource IconButtonStyle}" ToolTip="Налаштування"/>
                        </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Row="1" Text=""
                           Foreground="#99FFFFFF" FontSize="12" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CountdownText" Foreground="#66D9FF" FontSize="12"
                               Margin="0,0,0,8"/>
                    <ScrollViewer x:Name="LessonsScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LessonsPanel"/>
                    </ScrollViewer>
                    <Border x:Name="EmptyDayPanel" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyDayFace" Text=":)" FontSize="58"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyDayMessage" Foreground="#B8FFFFFF"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                        <Button Content="‹" Click="PreviousDayButton_Click"
                            Style="{StaticResource ArrowButtonStyle}" ToolTip="Попередній день"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <TextBlock x:Name="ClockText" Foreground="#F0FFFFFF" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SelectedDayText" Text="Субота" Foreground="#D8FFFFFF"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>
                        <Button Content="›" Click="NextDayButton_Click"
                            Style="{StaticResource ArrowButtonStyle}" ToolTip="Наступний день"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>